#:include 'generics.fypp'
!----------------------------------------------------------------------
! Module: type_diag_blk
!> Diagnostic block derived type
! Author: Benjamin Menetrier
! Licensing: this code is distributed under the CeCILL-C license
! Copyright 2015-... UCAR, CERFACS, METEO-FRANCE, IRIT and Meteorologisk Institutt
!----------------------------------------------------------------------
module type_diag_blk

!$ use omp_lib
use tools_const, only: zero,tenth,half,one,five,ten,pi,req
use tools_cor_var, only: eval
use tools_fit, only: condmax,diag_iso,diag_tensor,tensor_d2r,tensor_d2e,tensor_check_cond,fast_fit
use tools_func, only: vert_interp_size,vert_interp_setup,vert_interp,zss_sum,write_yaml_profile
use tools_kinds, only: kind_real
use tools_netcdf, only: define_grp,define_dim,define_var,put_var
use tools_repro, only: inf,infeq,supeq
use tools_wrfda
use type_diag_set, only: diag_set_type
use type_geom, only: geom_type
use type_minim, only: minim_type
use type_mpl, only: mpl_type
use type_nam, only: nam_type
use type_samp, only: samp_type,samp_flt_type

implicit none

real(kind_real),parameter :: bound = five !< Restriction bound applied on local diagnostics with respect to the global diagnostic

! Diagnostic block derived type
type diag_blk_type
   type(diag_set_type) :: glb                !< Global set
   type(diag_set_type),allocatable :: loc(:) !< Local sets
contains
   procedure :: alloc => diag_blk_alloc
   procedure :: partial_dealloc => diag_blk_partial_dealloc
   procedure :: dealloc => diag_blk_dealloc
   procedure :: filter_hor => diag_blk_filter_hor
   procedure :: interp => diag_blk_interp
end type diag_blk_type

private
public :: diag_blk_type

contains

!----------------------------------------------------------------------
! Subroutine: diag_blk_alloc
!> Allocation
!----------------------------------------------------------------------
subroutine diag_blk_alloc(diag_blk,mpl,nam,geom,samp,prefix)

implicit none

! Passed variables
class(diag_blk_type),intent(inout) :: diag_blk !< Diagnostic block
type(mpl_type),intent(inout) :: mpl            !< MPI data
type(nam_type),intent(in) :: nam               !< Namelist
type(geom_type),intent(in) :: geom             !< Geometry
type(samp_type),intent(in) :: samp             !< Sampling
character(len=*),intent(in) :: prefix          !< Block prefix

! Local variables
integer :: ic2a

! Set name
@:set_name(diag_blk_alloc)

! Global
call diag_blk%glb%alloc(mpl,nam,geom,samp,prefix)

! Local
if (samp%nc2a>0) then
   allocate(diag_blk%loc(samp%nc2a))
   do ic2a=1,samp%nc2a
      call diag_blk%loc(ic2a)%alloc(mpl,nam,geom,samp,prefix,ic2a)
   end do
end if

end subroutine diag_blk_alloc

!----------------------------------------------------------------------
! Subroutine: diag_blk_partial_dealloc
!> Release memory (partial)
!----------------------------------------------------------------------
subroutine diag_blk_partial_dealloc(diag_blk)

implicit none

! Passed variables
class(diag_blk_type),intent(inout) :: diag_blk !< Diagnostic block

! Local variables
integer :: ic2a

! Set name
@:set_name(diag_blk_partial_dealloc)

! Global
call diag_blk%glb%partial_dealloc

! Local
if (allocated(diag_blk%loc)) then
   do ic2a=1,size(diag_blk%loc)
      call diag_blk%loc(ic2a)%partial_dealloc
   end do
end if

end subroutine diag_blk_partial_dealloc

!----------------------------------------------------------------------
! Subroutine: diag_blk_dealloc
!> Release memory
!----------------------------------------------------------------------
subroutine diag_blk_dealloc(diag_blk)

implicit none

! Passed variables
class(diag_blk_type),intent(inout) :: diag_blk !< Diagnostic block

! Local variables
integer :: ic2a

! Set name
@:set_name(diag_blk_dealloc)

! Global
call diag_blk%glb%dealloc

! Local
if (allocated(diag_blk%loc)) then
   do ic2a=1,size(diag_blk%loc)
      call diag_blk%loc(ic2a)%dealloc
   end do
   deallocate(diag_blk%loc)
end if

end subroutine diag_blk_dealloc


!----------------------------------------------------------------------
! Subroutine: diag_blk_filter_hor
!> Horizontal filter of fit parameters or hybridization coefficients
!----------------------------------------------------------------------
subroutine diag_blk_filter_hor(diag_blk,mpl,nam,geom,samp,flt,hyb_coef_only)

implicit none

! Passed variables
class(diag_blk_type),intent(inout) :: diag_blk !< Diagnostic block
type(mpl_type),intent(inout) :: mpl            !< MPI data
type(nam_type),intent(in) :: nam               !< Namelist
type(geom_type),intent(in) :: geom             !< Geometry
type(samp_type),intent(in) :: samp             !< Sampling
type(samp_flt_type),intent(in) :: flt          !< Diagnostic filtering data
logical,intent(in) :: hyb_coef_only            !< Filter hybridization coefficient only

! Local variables
integer :: il0,ic2a,icmp
real(kind_real) :: a_tot
real(kind_real),allocatable :: a_c2a(:,:,:),s_c2a(:,:,:),rh_c2a(:,:),D11_c2a(:,:),D22_c2a(:,:),D12_c2a(:,:),rv_c2a(:,:)
real(kind_real),allocatable :: hyb_coef_1_c2a(:,:),hyb_coef_2_c2a(:,:)

! Set name
@:set_name(diag_blk_filter_hor)

! Allocation
if (hyb_coef_only) then
   allocate(hyb_coef_1_c2a(samp%nc2a,geom%nl0))
   allocate(hyb_coef_2_c2a(samp%nc2a,geom%nl0))
else
   allocate(a_c2a(samp%nc2a,geom%nl0,diag_blk%glb%ncmp))
   allocate(s_c2a(samp%nc2a,geom%nl0,diag_blk%glb%ncmp))
   if (nam%nc4==1) then
      allocate(rh_c2a(samp%nc2a,geom%nl0))
   else
      allocate(D11_c2a(samp%nc2a,geom%nl0))
      allocate(D22_c2a(samp%nc2a,geom%nl0))
      allocate(D12_c2a(samp%nc2a,geom%nl0))
   end if
   allocate(rv_c2a(samp%nc2a,geom%nl0))
end if
do il0=1,geom%nl0
   do ic2a=1,samp%nc2a
      ! Copy data
      if (hyb_coef_only) then
         hyb_coef_1_c2a(ic2a,il0) = diag_blk%loc(ic2a)%hyb_coef_1(il0)
         hyb_coef_2_c2a(ic2a,il0) = diag_blk%loc(ic2a)%hyb_coef_2(il0)
      else
         do icmp=1,diag_blk%glb%ncmp
            a_c2a(ic2a,il0,icmp) = diag_blk%loc(ic2a)%a_l0(il0,icmp)
            s_c2a(ic2a,il0,icmp) = diag_blk%loc(ic2a)%s_l0(il0,icmp)
         end do
         if (nam%nc4==1) then
            rh_c2a(ic2a,il0) = diag_blk%loc(ic2a)%rh_l0(il0)
         else
            D11_c2a(ic2a,il0) = diag_blk%loc(ic2a)%D11_l0(il0)
            D22_c2a(ic2a,il0) = diag_blk%loc(ic2a)%D22_l0(il0)
            D12_c2a(ic2a,il0) = diag_blk%loc(ic2a)%D12_l0(il0)
         end if
         rv_c2a(ic2a,il0) = diag_blk%loc(ic2a)%rv_l0(il0)
      end if

      ! Apply global bounds
      if (hyb_coef_only) then
         if (mpl%msv%isnot(hyb_coef_1_c2a(ic2a,il0)).and.mpl%msv%isnot(diag_blk%glb%hyb_coef_1(il0))) then
            if ((hyb_coef_1_c2a(ic2a,il0)<diag_blk%glb%hyb_coef_1(il0)/bound) &
 & .or.(hyb_coef_1_c2a(ic2a,il0)>diag_blk%glb%hyb_coef_1(il0)*bound)) hyb_coef_1_c2a(ic2a,il0) = mpl%msv%valr
         end if
         if (mpl%msv%isnot(hyb_coef_2_c2a(ic2a,il0)).and.mpl%msv%isnot(diag_blk%glb%hyb_coef_2(il0))) then
            if ((hyb_coef_2_c2a(ic2a,il0)<diag_blk%glb%hyb_coef_2(il0)/bound) &
 & .or.(hyb_coef_2_c2a(ic2a,il0)>diag_blk%glb%hyb_coef_2(il0)*bound)) hyb_coef_2_c2a(ic2a,il0) = mpl%msv%valr
         end if
      else
         do icmp=1,diag_blk%glb%ncmp
            if (mpl%msv%isnot(a_c2a(ic2a,il0,icmp)).and.mpl%msv%isnot(diag_blk%glb%a_l0(il0,icmp))) then
               if ((a_c2a(ic2a,il0,icmp)<diag_blk%glb%a_l0(il0,icmp)/bound) &
 & .or.(a_c2a(ic2a,il0,icmp)>diag_blk%glb%a_l0(il0,icmp)*bound)) a_c2a(ic2a,il0,icmp) = mpl%msv%valr
            end if
            if (mpl%msv%isnot(s_c2a(ic2a,il0,icmp)).and.mpl%msv%isnot(diag_blk%glb%s_l0(il0,icmp))) then
               if ((s_c2a(ic2a,il0,icmp)<diag_blk%glb%s_l0(il0,icmp)/bound) &
 & .or.(s_c2a(ic2a,il0,icmp)>diag_blk%glb%s_l0(il0,icmp)*bound)) s_c2a(ic2a,il0,icmp) = mpl%msv%valr
            end if
         end do
         if (nam%nc4==1) then
            if (mpl%msv%isnot(rh_c2a(ic2a,il0)).and.mpl%msv%isnot(diag_blk%glb%rh_l0(il0))) then
               if ((rh_c2a(ic2a,il0)<diag_blk%glb%rh_l0(il0)/bound) &
 & .or.(rh_c2a(ic2a,il0)>diag_blk%glb%rh_l0(il0)*bound)) rh_c2a(ic2a,il0) = mpl%msv%valr
            end if
         else
            if (mpl%msv%isnot(D11_c2a(ic2a,il0)).and.mpl%msv%isnot(diag_blk%glb%D11_l0(il0))) then
               if ((D11_c2a(ic2a,il0)<diag_blk%glb%D11_l0(il0)/bound) &
 & .or.(D11_c2a(ic2a,il0)>diag_blk%glb%D11_l0(il0)*bound)) D11_c2a(ic2a,il0) = mpl%msv%valr
            end if
            if (mpl%msv%isnot(D22_c2a(ic2a,il0)).and.mpl%msv%isnot(diag_blk%glb%D22_l0(il0))) then
               if ((D22_c2a(ic2a,il0)<diag_blk%glb%D22_l0(il0)/bound) &
 & .or.(D22_c2a(ic2a,il0)>diag_blk%glb%D22_l0(il0)*bound)) D22_c2a(ic2a,il0) = mpl%msv%valr
            end if
         end if
         if (mpl%msv%isnot(rv_c2a(ic2a,il0)).and.mpl%msv%isnot(diag_blk%glb%rv_l0(il0))) then
            if ((rv_c2a(ic2a,il0)<diag_blk%glb%rv_l0(il0)/bound) &
 & .or.(rv_c2a(ic2a,il0)>diag_blk%glb%rv_l0(il0)*bound)) rv_c2a(ic2a,il0) = mpl%msv%valr
         end if
      end if
   end do

   if (nam%diag_rhflt>zero) then
      ! Median filter to remove extreme values, average filter to smooth data
      if (hyb_coef_only) then
         call samp%diag_filter(mpl,flt,'median',hyb_coef_1_c2a(:,il0))
         call samp%diag_filter(mpl,flt,'average',hyb_coef_1_c2a(:,il0))
         call samp%diag_filter(mpl,flt,'median',hyb_coef_2_c2a(:,il0))
         call samp%diag_filter(mpl,flt,'average',hyb_coef_2_c2a(:,il0))
      else
         do icmp=1,diag_blk%glb%ncmp
            call samp%diag_filter(mpl,flt,'median',a_c2a(:,il0,icmp))
            call samp%diag_filter(mpl,flt,'average',a_c2a(:,il0,icmp))
            call samp%diag_filter(mpl,flt,'median',s_c2a(:,il0,icmp))
            call samp%diag_filter(mpl,flt,'average',s_c2a(:,il0,icmp))
         end do
         if (nam%nc4==1) then
            call samp%diag_filter(mpl,flt,'median',rh_c2a(:,il0))
            call samp%diag_filter(mpl,flt,'average',rh_c2a(:,il0))
         else
            call samp%diag_filter(mpl,flt,'median',D11_c2a(:,il0))
            call samp%diag_filter(mpl,flt,'average',D11_c2a(:,il0))
            call samp%diag_filter(mpl,flt,'median',D22_c2a(:,il0))
            call samp%diag_filter(mpl,flt,'average',D22_c2a(:,il0))
            call samp%diag_filter(mpl,flt,'median',D12_c2a(:,il0))
            call samp%diag_filter(mpl,flt,'average',D12_c2a(:,il0))
         end if
         call samp%diag_filter(mpl,flt,'median',rv_c2a(:,il0))
         call samp%diag_filter(mpl,flt,'average',rv_c2a(:,il0))
      end if
   end if


   ! Fill missing values
   if (hyb_coef_only) then
      call samp%diag_fill(mpl,hyb_coef_1_c2a(:,il0))
      call samp%diag_fill(mpl,hyb_coef_2_c2a(:,il0))
   else
      do icmp=1,diag_blk%glb%ncmp
         call samp%diag_fill(mpl,a_c2a(:,il0,icmp))
         call samp%diag_fill(mpl,s_c2a(:,il0,icmp))
      end do
      if (nam%nc4==1) then
         call samp%diag_fill(mpl,rh_c2a(:,il0))
      else
         call samp%diag_fill(mpl,D11_c2a(:,il0))
         call samp%diag_fill(mpl,D22_c2a(:,il0))
         call samp%diag_fill(mpl,D12_c2a(:,il0))
      end if
      call samp%diag_fill(mpl,rv_c2a(:,il0))
   end if

   ! Copy data
   do ic2a=1,samp%nc2a
      if (hyb_coef_only) then
         diag_blk%loc(ic2a)%hyb_coef_1(il0) = hyb_coef_1_c2a(ic2a,il0)
         diag_blk%loc(ic2a)%hyb_coef_2(il0) = hyb_coef_2_c2a(ic2a,il0)
      else
         do icmp=1,diag_blk%glb%ncmp
            diag_blk%loc(ic2a)%a_l0(il0,icmp) = a_c2a(ic2a,il0,icmp)
            diag_blk%loc(ic2a)%s_l0(il0,icmp) = s_c2a(ic2a,il0,icmp)
         end do
         if (nam%nc4==1) then
            diag_blk%loc(ic2a)%rh_l0(il0) = rh_c2a(ic2a,il0)
         else
            diag_blk%loc(ic2a)%D11_l0(il0) = D11_c2a(ic2a,il0)
            diag_blk%loc(ic2a)%D22_l0(il0) = D22_c2a(ic2a,il0)
            diag_blk%loc(ic2a)%D12_l0(il0) = D12_c2a(ic2a,il0)
            call tensor_d2r(mpl,diag_blk%loc(ic2a)%D11_l0(il0),diag_blk%loc(ic2a)%D22_l0(il0), &
 & diag_blk%loc(ic2a)%D12_l0(il0),diag_blk%loc(ic2a)%rh_l0(il0))
            call tensor_d2e(mpl,diag_blk%loc(ic2a)%D11_l0(il0),diag_blk%loc(ic2a)%D22_l0(il0), &
 & diag_blk%loc(ic2a)%D12_l0(il0),diag_blk%loc(ic2a)%ecc_l0(il0))
         end if
         diag_blk%loc(ic2a)%rv_l0(il0) = rv_c2a(ic2a,il0)
      end if
   end do

   ! Reset total amplitude to one
   do ic2a=1,samp%nc2a
      if (.not.hyb_coef_only) then
         a_tot = sum(diag_blk%loc(ic2a)%a_l0(il0,:))
         if (a_tot>0.0) diag_blk%loc(ic2a)%a_l0(il0,:) = diag_blk%loc(ic2a)%a_l0(il0,:)/a_tot
      end if
   end do
end do

! Release memory
if (hyb_coef_only) then
   deallocate(hyb_coef_1_c2a)
   deallocate(hyb_coef_2_c2a)
else
   deallocate(a_c2a)
   deallocate(s_c2a)
   if (nam%nc4==1) then
      deallocate(rh_c2a)
   else
      deallocate(D11_c2a)
      deallocate(D22_c2a)
      deallocate(D12_c2a)
   end if
   deallocate(rv_c2a)
end if

end subroutine diag_blk_filter_hor

!----------------------------------------------------------------------
! Subroutine: diag_blk_interp
!> Interpolation of fit parameters or hybridization coefficients
!----------------------------------------------------------------------
subroutine diag_blk_interp(diag_blk,mpl,nam,geom,samp,hyb_coef_only)

implicit none

! Passed variables
class(diag_blk_type),intent(inout) :: diag_blk !< Diagnostic block
type(mpl_type),intent(inout) :: mpl            !< MPI data
type(nam_type),intent(in) :: nam               !< Namelist
type(geom_type),intent(in) :: geom             !< Geometry
type(samp_type),intent(in) :: samp             !< Sampling
logical,intent(in) :: hyb_coef_only            !< Filter hybridization coefficient only

! Local variables
integer :: n,i,il0,il0i,ic2amin,ic2amax,ic2a,ic0a,icmp
real(kind_real),allocatable :: fld_c2a(:,:,:),fld_c2b(:,:,:),fld_c0a(:,:,:)

! Set name
@:set_name(diag_blk_interp)

! Allocation
if (hyb_coef_only) then
   allocate(diag_blk%glb%hyb_coef_1_c0a(geom%nc0a,geom%nl0))
   allocate(diag_blk%glb%hyb_coef_2_c0a(geom%nc0a,geom%nl0))
else
   allocate(diag_blk%glb%a_c0a(geom%nc0a,geom%nl0,diag_blk%glb%ncmp))
   allocate(diag_blk%glb%s_c0a(geom%nc0a,geom%nl0,diag_blk%glb%ncmp))
   allocate(diag_blk%glb%rh_c0a(geom%nc0a,geom%nl0))
   if (nam%nc4>1) then
      allocate(diag_blk%glb%D11_c0a(geom%nc0a,geom%nl0))
      allocate(diag_blk%glb%D22_c0a(geom%nc0a,geom%nl0))
      allocate(diag_blk%glb%D12_c0a(geom%nc0a,geom%nl0))
      allocate(diag_blk%glb%ecc_c0a(geom%nc0a,geom%nl0))
   end if
   allocate(diag_blk%glb%rv_c0a(geom%nc0a,geom%nl0,diag_blk%glb%ncmp))
end if

! Initialization
if (nam%local_diag) then
   ! Allocation
   if (hyb_coef_only) then
      ! Interpolate hybridization coeffient
      n = 2
   else
      ! Interpolate fit parameters
      n = 2*diag_blk%glb%ncmp+2
      if (nam%nc4>1) n = n+4
   end if
   allocate(fld_c2a(samp%nc2a,geom%nl0,n))
   allocate(fld_c2b(samp%nc2b,geom%nl0,n))
   allocate(fld_c0a(geom%nc0a,geom%nl0,n))

   do ic2a=1,samp%nc2a
      ! Select profile
      if (hyb_coef_only) then
         fld_c2a(ic2a,:,1) = diag_blk%loc(ic2a)%hyb_coef_1
         fld_c2a(ic2a,:,2) = diag_blk%loc(ic2a)%hyb_coef_2
      else
         i = 0
         do icmp=1,diag_blk%glb%ncmp
            i = i+1
            fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%a_l0(:,icmp)
            i = i+1
            fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%s_l0(:,icmp)
         end do
         i = i+1
         fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%rh_l0
         if (nam%nc4>1) then
            i = i+1
            fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%D11_l0
            i = i+1
            fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%D22_l0
            i = i+1
            fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%D12_l0
            i = i+1
            fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%ecc_l0
         end if
         i = i+1
         fld_c2a(ic2a,:,i) = diag_blk%loc(ic2a)%rv_l0
      end if
   end do

   ! Fill missing values
   do i=1,n
      do il0=1,geom%nl0
         call samp%diag_fill(mpl,fld_c2a(:,il0,i))
      end do
   end do

   ! Halo extension
   call samp%com_c2_AB%ext(mpl,fld_c2a,fld_c2b)

   ! Interpolation
   do i=1,n
      do il0=1,geom%nl0
         if (samp%nc2b>0) then
            if (mpl%msv%isanynot(fld_c2b(:,il0,i))) then
               il0i = min(il0,geom%nl0i)
               call samp%interp_c2b_to_c0a(il0i)%apply(mpl,fld_c2b(:,il0,i),fld_c0a(:,il0,i))
            else
               fld_c0a(:,il0,i) = mpl%msv%valr
            end if
         else
            fld_c0a(:,il0,i) = mpl%msv%valr
         end if
      end do
   end do

   ! Copy field
   if (hyb_coef_only) then
      diag_blk%glb%hyb_coef_1_c0a = fld_c0a(:,:,1)
      diag_blk%glb%hyb_coef_2_c0a = fld_c0a(:,:,2)
   else
      i = 0
      do icmp=1,diag_blk%glb%ncmp
         i = i+1
         diag_blk%glb%a_c0a(:,:,icmp) = fld_c0a(:,:,i)
         i = i+1
         diag_blk%glb%s_c0a(:,:,icmp) = fld_c0a(:,:,i)
      end do
      i = i+1
      diag_blk%glb%rh_c0a = fld_c0a(:,:,i)
      if (nam%nc4>1) then
         i = i+1
         diag_blk%glb%D11_c0a = fld_c0a(:,:,i)
         i = i+1
         diag_blk%glb%D22_c0a = fld_c0a(:,:,i)
         i = i+1
         diag_blk%glb%D12_c0a = fld_c0a(:,:,i)
         i = i+1
         diag_blk%glb%ecc_c0a = fld_c0a(:,:,i)
      end if
      i = i+1
      do icmp=1,diag_blk%glb%ncmp
         diag_blk%glb%rv_c0a(:,:,icmp) = fld_c0a(:,:,i)*diag_blk%glb%s_c0a(:,:,icmp)
      end do
   end if

   ! Release memory
   deallocate(fld_c2a)
   deallocate(fld_c2b)
   deallocate(fld_c0a)
else
   ! Copy profiles
   do il0=1,geom%nl0
      do ic0a=1,geom%nc0a
         if (geom%gmask_c0a(ic0a,il0)) then
            if (hyb_coef_only) then
               diag_blk%glb%hyb_coef_1_c0a(ic0a,il0) = diag_blk%glb%hyb_coef_1(il0)
               diag_blk%glb%hyb_coef_2_c0a(ic0a,il0) = diag_blk%glb%hyb_coef_2(il0)
            else
               do icmp=1,diag_blk%glb%ncmp
                  diag_blk%glb%a_c0a(ic0a,il0,icmp) = diag_blk%glb%a_l0(il0,icmp)
                  diag_blk%glb%s_c0a(ic0a,il0,icmp) = diag_blk%glb%s_l0(il0,icmp)
               end do
               diag_blk%glb%rh_c0a(ic0a,il0) = diag_blk%glb%rh_l0(il0)
               if (nam%nc4>1) then
                  diag_blk%glb%D11_c0a(ic0a,il0) = diag_blk%glb%D11_l0(il0)
                  diag_blk%glb%D22_c0a(ic0a,il0) = diag_blk%glb%D22_l0(il0)
                  diag_blk%glb%D12_c0a(ic0a,il0) = diag_blk%glb%D12_l0(il0)
                  diag_blk%glb%ecc_c0a(ic0a,il0) = diag_blk%glb%ecc_l0(il0)
               end if
               do icmp=1,diag_blk%glb%ncmp
                  diag_blk%glb%rv_c0a(ic0a,il0,icmp) = diag_blk%glb%rv_l0(il0)*diag_blk%glb%s_c0a(ic0a,il0,icmp)
               end do
            end if
         end if
      end do
   end do
end if

if (.not.hyb_coef_only) then
   ! Normalize amplitude
   do il0=1,geom%nl0
      do ic0a=1,geom%nc0a
         if (geom%gmask_c0a(ic0a,il0)) diag_blk%glb%a_c0a(ic0a,il0,:) = diag_blk%glb%a_c0a(ic0a,il0,:) &
 & /sum(diag_blk%glb%a_c0a(ic0a,il0,:))
      end do
   end do
end if

end subroutine diag_blk_interp

end module type_diag_blk
