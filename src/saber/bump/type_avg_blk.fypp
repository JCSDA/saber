#:include 'generics.fypp'
!----------------------------------------------------------------------
! Module: type_avg_blk
!> Averaged statistics block derived type
! Author: Benjamin Menetrier
! Licensing: this code is distributed under the CeCILL-C license
! Copyright 2015-... UCAR, CERFACS, METEO-FRANCE and IRIT
!----------------------------------------------------------------------
module type_avg_blk

use type_avg_set, only: avg_set_type
use type_geom, only: geom_type
use type_mpl, only: mpl_type
use type_nam, only: nam_type
use type_samp, only: samp_type

implicit none

! Averaged statistics block derived type
type avg_blk_type
   integer :: iv                            !< Variable index
   integer :: ig                            !< Group index
   type(avg_set_type) :: glb                !< Global set
   type(avg_set_type),allocatable :: loc(:) !< Local set
contains
   procedure :: avg_blk_alloc_var
   procedure :: avg_blk_alloc_grp
   generic :: alloc => avg_blk_alloc_var,avg_blk_alloc_grp
   procedure :: dealloc => avg_blk_dealloc
end type avg_blk_type

private
public :: avg_blk_type

contains

!----------------------------------------------------------------------
! Subroutine: avg_blk_alloc_var
!> Allocation for variables
!----------------------------------------------------------------------
subroutine avg_blk_alloc_var(avg_blk,mpl,nam,geom,samp,ne,nsub,iv)

implicit none

! Passed variables
class(avg_blk_type),intent(inout) :: avg_blk !< Averaged statistics block
type(mpl_type),intent(inout) :: mpl          !< MPI data
type(nam_type),intent(in) :: nam             !< Namelist
type(geom_type),intent(in) :: geom           !< Geometry
type(samp_type),intent(in) :: samp           !< Sampling
integer,intent(in) :: ne                     !< Ensemble size
integer,intent(in) :: nsub                   !< Sub-ensembles number
integer,intent(in) :: iv                     !< Variable index

! Local variables
integer :: ic2a

! Set name
@:set_name(avg_blk_alloc_blk)

! Set indices
avg_blk%iv = iv
avg_blk%ig = mpl%msv%vali

! Global
call avg_blk%glb%alloc(mpl,nam,geom,ne,nsub)

! Local
if (samp%nc2a>0) then
   allocate(avg_blk%loc(samp%nc2a))
   do ic2a=1,samp%nc2a
      call avg_blk%loc(ic2a)%alloc(mpl,nam,geom,ne,nsub,ic2a)
   end do
end if

end subroutine avg_blk_alloc_var

!----------------------------------------------------------------------
! Subroutine: avg_blk_alloc_grp
!> Allocation for groups
!----------------------------------------------------------------------
subroutine avg_blk_alloc_grp(avg_blk,mpl,nam,geom,samp,ig)

implicit none

! Passed variables
class(avg_blk_type),intent(inout) :: avg_blk !< Averaged statistics block
type(mpl_type),intent(inout) :: mpl          !< MPI data
type(nam_type),intent(in) :: nam             !< Namelist
type(geom_type),intent(in) :: geom           !< Geometry
type(samp_type),intent(in) :: samp           !< Sampling
integer,intent(in) :: ig                     !< Group index

! Local variables
integer :: ic2a

! Set name
@:set_name(avg_blk_alloc_grp)

! Set indices
avg_blk%iv = mpl%msv%vali
avg_blk%ig = ig

! Global
call avg_blk%glb%alloc(mpl,nam,geom)

! Local
if (samp%nc2a>0) then
   allocate(avg_blk%loc(samp%nc2a))
   do ic2a=1,samp%nc2a
      call avg_blk%loc(ic2a)%alloc(mpl,nam,geom,ic2a)
   end do
end if

end subroutine avg_blk_alloc_grp

!----------------------------------------------------------------------
! Subroutine: avg_blk_dealloc
!> Release memory
!----------------------------------------------------------------------
subroutine avg_blk_dealloc(avg_blk)

implicit none

! Passed variables
class(avg_blk_type),intent(inout) :: avg_blk !< Averaged statistics block

! Local variables
integer :: ic2a

! Set name
@:set_name(avg_blk_dealloc)

! Global
call avg_blk%glb%dealloc

! Local
if (allocated(avg_blk%loc)) then
   do ic2a=1,size(avg_blk%loc)
      call avg_blk%loc(ic2a)%dealloc
   end do
   deallocate(avg_blk%loc)
end if

end subroutine avg_blk_dealloc

end module type_avg_blk
