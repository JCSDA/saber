#:include 'generics.fypp'
!----------------------------------------------------------------------
! Module: type_avg
!> Average routines
! Author: Benjamin Menetrier
! Licensing: this code is distributed under the CeCILL-C license
! Copyright 2015-... UCAR, CERFACS, METEO-FRANCE and IRIT
!----------------------------------------------------------------------
module type_avg

use fckit_mpi_module, only: fckit_mpi_status
!$ use omp_lib
use tools_const, only: zero,one
use tools_kinds, only: kind_real
use tools_netcdf, only: create_file,open_file,get_att,put_att,define_dim,define_grp,inquire_grp,close_file
use type_avg_blk, only: avg_blk_type
use type_geom, only: geom_type
use type_mom, only: mom_type
use type_mom_blk, only: mom_blk_type
use type_mpl, only: mpl_type
use type_nam, only: nam_type
use type_samp, only: samp_type

implicit none

! Averaged statistics derived type
type avg_type
   character(len=1024) :: prefix            !< Prefix
   integer :: ne                            !< Ensemble size
   integer :: nsub                          !< Number of sub-ensembles
   type(avg_blk_type),allocatable :: var(:) !< Averaged statistics for each variable
   type(avg_blk_type),allocatable :: grp(:) !< Averaged statistics for each group
contains
   procedure :: alloc => avg_alloc
   procedure :: dealloc => avg_dealloc
   procedure :: avg_read
   procedure :: avg_read_single
   generic :: read => avg_read,avg_read_single
   procedure :: avg_write
   procedure :: avg_write_single
   generic :: write => avg_write,avg_write_single
   procedure :: send => avg_send
   procedure :: receive => avg_receive
   procedure :: write_hist => avg_write_hist
   procedure :: compute => avg_compute
end type avg_type

real(kind_real),parameter :: egvmin = 1.0e-12_kind_real !< Minimum eigenvalue for full vertical covariance matrix inversion

private
public :: avg_type

contains

!----------------------------------------------------------------------
! Subroutine: avg_alloc
!> Allocation
!----------------------------------------------------------------------
subroutine avg_alloc(avg,mpl,nam,geom,samp,ne,nsub,prefix)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg  !< Averaged statistics
type(mpl_type),intent(inout) :: mpl   !< MPI data
type(nam_type),intent(in) :: nam      !< Namelist
type(geom_type),intent(in) :: geom    !< Geometry
type(samp_type),intent(in) :: samp    !< Sampling
integer,intent(in) :: ne              !< Ensemble size
integer,intent(in) :: nsub            !< Number of sub-ensembles
character(len=*),intent(in) :: prefix !< Prefix

! Local variables
integer :: iv,ig

! Set name
@:set_name(avg_alloc)

! Set attributes
avg%prefix = prefix
avg%ne = ne
avg%nsub = nsub

! Variables
allocate(avg%var(nam%nv))
do iv=1,nam%nv
   call avg%var(iv)%alloc(mpl,nam,geom,samp,ne,nsub,ig)
end do

! Groups
allocate(avg%grp(nam%ng))
do ig=1,nam%ng
   call avg%grp(ig)%alloc(mpl,nam,geom,samp,ig)
end do

end subroutine avg_alloc

!----------------------------------------------------------------------
! Subroutine: avg_dealloc
!> Release memory
!----------------------------------------------------------------------
subroutine avg_dealloc(avg)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg !< Averaged statistics

! Local variables
integer :: iv,ig

! Set name
@:set_name(avg_dealloc)

! Variables
if (allocated(avg%var)) then
   do iv=1,size(avg%var)
      call avg%var(iv)%dealloc
   end do
   deallocate(avg%var)
end if

! Groups
if (allocated(avg%grp)) then
   do ig=1,size(avg%grp)
      call avg%grp(ig)%dealloc
   end do
   deallocate(avg%grp)
end if

end subroutine avg_dealloc

!----------------------------------------------------------------------
! Subroutine: avg_read
!> Read
!----------------------------------------------------------------------
subroutine avg_read(avg,mpl,nam,geom,samp)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg !< Averaged statistics
type(mpl_type),intent(inout) :: mpl  !< MPI data
type(nam_type),intent(in) :: nam     !< Namelist
type(geom_type),intent(in) :: geom   !< Geometry
type(samp_type),intent(in) :: samp   !< Sampling

! Local variables
integer :: iproc,iprocio
type(avg_type) :: avg_tmp

! Set name
@:set_name(avg_read)

do iproc=1,mpl%nproc
   ! Reading task
   iprocio = mod(iproc,mpl%nprocio)
   if (iprocio==0) iprocio = mpl%nprocio

   if (mpl%myproc==iprocio) then
      write(mpl%info,'(a10,a,i6,a,i6)') '','Read averaged statistics of task ',iproc,' from task ',iprocio
      call mpl%flush

      if (iproc==iprocio) then
         ! Read data
         call avg%read(mpl,nam,geom,samp,iproc)
      else
         ! Read data
         call avg_tmp%read(mpl,nam,geom,samp,iproc)

         ! Send data to task iproc
         call avg_tmp%send(mpl,nam,geom,samp,iproc)

         ! Release memory
         call avg_tmp%dealloc
      end if
   elseif (mpl%myproc==iproc) then
      ! Receive data from task iprocio
      write(mpl%info,'(a10,a,i6,a,i6)') '','Receive averaged statistics of task ',iproc,' from task ',iprocio
      call mpl%flush
      call avg%receive(mpl,nam,geom,samp,iprocio)
   end if
end do

! Update tag
call mpl%update_tag(3)

end subroutine avg_read

!----------------------------------------------------------------------
! Subroutine: avg_read_single
!> Read, single task
!----------------------------------------------------------------------
subroutine avg_read_single(avg,mpl,nam,geom,samp,iproc)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg !< Averaged statistics
type(mpl_type),intent(inout) :: mpl  !< MPI data
type(nam_type),intent(in) :: nam     !< Namelist
type(geom_type),intent(in) :: geom   !< Geometry
type(samp_type),intent(in) :: samp   !< Sampling
integer,intent(in) :: iproc          !< Task index

! Local variables
integer :: ig,ic2a,nc2a
integer :: ncid,grpid,locid
character(len=1024) :: grpname,locname

! Set name
@:set_name(avg_read_single)

! Open file
ncid = open_file(mpl,nam%fname_avg,iproc)

! Get attribute
call get_att(mpl,ncid,0,'nc2a',nc2a)
if (nc2a/=samp%nc2a) call mpl%abort('${subr}$','nc2a in file is not equal to samp%nc2a')

! Allocation
allocate(avg%grp(nam%ng))
do ig=1,nam%ng
   call avg%grp(ig)%alloc(mpl,nam,geom,samp,ig)
end do

do ig=1,nam%ng
   ! Get group name
   write(grpname,'(a,a)') trim(nam%group_names(ig)),'_glb'

   ! Get group
   grpid = inquire_grp(mpl,ncid,grpname)

   ! Global set
   call avg%grp(ig)%glb%read(mpl,grpid)

   ! Local sets
   do ic2a=1,samp%nc2a
      ! Get subgroup name
      write(locname,'(a,i6.6)') 'loc_',ic2a

      ! Get subgroup
      locid = inquire_grp(mpl,grpid,locname)

      ! Read
      call avg%grp(ig)%loc(ic2a)%read(mpl,locid)
   end do
end do

! Close file
call close_file(mpl,ncid)

end subroutine avg_read_single

!----------------------------------------------------------------------
! Subroutine: avg_write
!> Write
!----------------------------------------------------------------------
subroutine avg_write(avg,mpl,nam,geom,samp)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg !< Averaged statistics
type(mpl_type),intent(inout) :: mpl  !< MPI data
type(nam_type),intent(in) :: nam     !< Namelist
type(geom_type),intent(in) :: geom   !< Geometry
type(samp_type),intent(in) :: samp   !< Sampling

! Local variables
integer :: iproc,iprocio
type(avg_type) :: avg_tmp

! Set name
@:set_name(avg_write)

do iproc=1,mpl%nproc
   ! Writing task
   iprocio = mod(iproc,mpl%nprocio)
   if (iprocio==0) iprocio = mpl%nprocio

   if (mpl%myproc==iprocio) then
      write(mpl%info,'(a10,a,i6,a,i6)') '','Write averaged statistics of task ',iproc,' from task ',iprocio
      call mpl%flush

      if (iproc==iprocio) then
         ! Write data
         call avg%write(mpl,nam,geom,samp,iproc)
      else
         ! Receive data from task iproc
         call avg_tmp%receive(mpl,nam,geom,samp,iproc)

         ! Write data
         call avg_tmp%write(mpl,nam,geom,samp,iproc)

         ! Release memory
         call avg_tmp%dealloc
      end if
   elseif (mpl%myproc==iproc) then
      ! Send data to task iprocio
      write(mpl%info,'(a10,a,i6,a,i6)') '','Send averaged statistics of task ',iproc,' to task ',iprocio
      call mpl%flush
      call avg%send(mpl,nam,geom,samp,iprocio)
   end if
end do

! Update tag
call mpl%update_tag(3)

end subroutine avg_write

!----------------------------------------------------------------------
! Subroutine: avg_write_single
!> Write, single task
!----------------------------------------------------------------------
subroutine avg_write_single(avg,mpl,nam,geom,samp,iproc)

implicit none

! Passed variables
class(avg_type),intent(in) :: avg   !< Averaged statistics
type(mpl_type),intent(inout) :: mpl !< MPI data
type(nam_type),intent(in) :: nam    !< Namelist
type(geom_type),intent(in) :: geom  !< Geometry
type(samp_type),intent(in) :: samp  !< Sampling
integer,intent(in) :: iproc         !< Task index

! Local variables
integer :: ig,ic2a
integer :: ncid,nc3_id,nc4_id,nl0r_id,nl0_id,grpid,locid
character(len=1024) :: grpname,locname

! Set name
@:set_name(avg_write_single)

! Create file
ncid = create_file(mpl,nam%fname_avg,nam%time_comm,iproc)

! Put attribute
call put_att(mpl,ncid,0,'nc2a',samp%nc2a)

! Define or get dimensions
nc3_id = define_dim(mpl,ncid,'nc3',nam%nc3)
nc4_id = define_dim(mpl,ncid,'nc4',nam%nc4)
nl0r_id = define_dim(mpl,ncid,'nl0r',nam%nl0r)
nl0_id = define_dim(mpl,ncid,'nl0',geom%nl0)

do ig=1,nam%ng
   ! Get group name
   write(grpname,'(a,a)') trim(nam%group_names(ig)),'_glb'

   ! Define group
   grpid = define_grp(mpl,ncid,grpname)

   ! Global set
   call avg%grp(ig)%glb%write(mpl,nc3_id,nc4_id,nl0r_id,nl0_id,grpid)

   ! Local sets
   do ic2a=1,samp%nc2a
      ! Get subgroup name
      write(locname,'(a,i6.6)') 'loc_',ic2a

      ! Get subgroup
      locid = inquire_grp(mpl,grpid,locname)

      ! Write
      call avg%grp(ig)%loc(ic2a)%write(mpl,nc3_id,nc4_id,nl0r_id,nl0_id,locid)
   end do
end do

! Close file
call close_file(mpl,ncid)

end subroutine avg_write_single

!----------------------------------------------------------------------
! Subroutine: avg_send
!> Send
!----------------------------------------------------------------------
subroutine avg_send(avg,mpl,nam,geom,samp,iproc)

implicit none

! Passed variables
class(avg_type),intent(in) :: avg  !< Averaged statistics
type(mpl_type),intent(inout) :: mpl !< MPI data
type(nam_type),intent(in) :: nam    !< Namelist
type(geom_type),intent(in) :: geom  !< Geometry
type(samp_type),intent(in) :: samp  !< Sampling
integer,intent(in) :: iproc         !< Destination task

! Local variables
integer :: nbufi,nbufr,ibufi,ibufr,ig,ic2a,bufs(2)
integer,allocatable :: bufi(:)
real(kind_real),allocatable :: bufr(:)

! Set name
@:set_name(avg_send)

! Initialization
nbufi = 0
nbufr = 0

! Global

! m11
nbufr = nbufr+nam%ng*nam%nc3*nam%nc4*nam%nl0r*geom%nl0

! m11sq
nbufr = nbufr+nam%ng*nam%nc3*nam%nc4*nam%nl0r*geom%nl0

! Local

! m11
nbufr = nbufr+nam%ng*samp%nc2a*nam%nc3*nam%nc4*nam%nl0r*geom%nl0

! m11sq
nbufr = nbufr+nam%ng*samp%nc2a*nam%nc3*nam%nc4*nam%nl0r*geom%nl0

! Allocation
allocate(bufi(nbufi))
allocate(bufr(nbufr))

! Initialization
ibufi = 0
ibufr = 0

! Global
do ig=1,nam%ng
   ! m11
   bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0) = reshape(avg%grp(ig)%glb%m11, &
 & (/nam%nc3*nam%nc4*nam%nl0r*geom%nl0/))
   ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0

   ! m11sq
   bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0) = reshape(avg%grp(ig)%glb%m11sq, &
 & (/nam%nc3*nam%nc4*nam%nl0r*geom%nl0/))
   ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0
end do

! Local

do ig=1,nam%ng
   do ic2a=1,samp%nc2a
      ! m11
      bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0) = reshape(avg%grp(ig)%loc(ic2a)%m11, &
 & (/nam%nc3*nam%nc4*nam%nl0r*geom%nl0/))
      ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0

      ! m11sq
      bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0) = reshape(avg%grp(ig)%loc(ic2a)%m11sq, &
 & (/nam%nc3*nam%nc4*nam%nl0r*geom%nl0/))
      ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0
   end do
end do

! Check sizes
if (ibufi/=nbufi) call mpl%abort('${subr}$','wrong final index ibufi')
if (ibufr/=nbufr) call mpl%abort('${subr}$','wrong final index ibufr')

! Send buffer size
bufs = (/nbufi,nbufr/)
call mpl%f_comm%send(bufs,iproc-1,mpl%tag)

! Send data
call mpl%f_comm%send(bufi,iproc-1,mpl%tag+1)
call mpl%f_comm%send(bufr,iproc-1,mpl%tag+2)

! Release memory
deallocate(bufi)
deallocate(bufr)

end subroutine avg_send

!----------------------------------------------------------------------
! Subroutine: avg_receive
!> Receive
!----------------------------------------------------------------------
subroutine avg_receive(avg,mpl,nam,geom,samp,iproc)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg !< Averaged statistics
type(mpl_type),intent(inout) :: mpl    !< MPI data
type(nam_type),intent(in) :: nam       !< Namelist
type(geom_type),intent(in) :: geom     !< Geometry
type(samp_type),intent(in) :: samp     !< Sampling
integer,intent(in) :: iproc            !< Source task

! Local variables
integer :: nbufi,nbufr,ibufi,ibufr,ig,ic2a,bufs(2)
integer,allocatable :: bufi(:)
real(kind_real),allocatable :: bufr(:)
type(fckit_mpi_status) :: status

! Set name
@:set_name(avg_receive)

! Receive buffer size
call mpl%f_comm%receive(bufs,iproc-1,mpl%tag,status)
nbufi = bufs(1)
nbufr = bufs(2)

! Allocation
allocate(bufi(nbufi))
allocate(bufr(nbufr))

! Receive data
call mpl%f_comm%receive(bufi,iproc-1,mpl%tag+1,status)
call mpl%f_comm%receive(bufr,iproc-1,mpl%tag+2,status)

! Initialization
ibufi = 0
ibufr = 0

! Allocation
allocate(avg%grp(nam%ng))
do ig=1,nam%ng
   call avg%grp(ig)%alloc(mpl,nam,geom,samp,ig)
end do

! Global
do ig=1,nam%ng
   ! m11
   avg%grp(ig)%glb%m11 = reshape(bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0), &
 & (/nam%nc3,nam%nc4,nam%nl0r,geom%nl0/))
   ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0

   ! m11sq
   avg%grp(ig)%glb%m11sq = reshape(bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0), &
 & (/nam%nc3,nam%nc4,nam%nl0r,geom%nl0/))
   ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0
end do

! Local
do ig=1,nam%ng
   do ic2a=1,samp%nc2a
      ! m11
      avg%grp(ig)%loc(ic2a)%m11 = reshape(bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0), &
 & (/nam%nc3,nam%nc4,nam%nl0r,geom%nl0/))
      ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0

      ! m11sq
      avg%grp(ig)%loc(ic2a)%m11sq = reshape(bufr(ibufr+1:ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0), &
 & (/nam%nc3,nam%nc4,nam%nl0r,geom%nl0/))
      ibufr = ibufr+nam%nc3*nam%nc4*nam%nl0r*geom%nl0
   end do
end do

! Check sizes
if (ibufi/=nbufi) call mpl%abort('${subr}$','wrong final index ibufi')
if (ibufr/=nbufr) call mpl%abort('${subr}$','wrong final index ibufr')

! Release memory
deallocate(bufr)

end subroutine avg_receive

!----------------------------------------------------------------------
! Subroutine: avg_write_hist
!> Write histograms
!----------------------------------------------------------------------
subroutine avg_write_hist(avg,mpl,nam,geom)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg !< Diagnostic
type(mpl_type),intent(inout) :: mpl  !< MPI data
type(nam_type),intent(in) :: nam     !< Namelist
type(geom_type),intent(in) :: geom   !< Geometry

! Local variables
integer :: ncid,iv,grpid
character(len=1024) :: filename,grpname

! Set name
@:set_name(avg_write_hist)

if (mpl%main) then
   ! File nmae
   filename = trim(nam%prefix)//trim(avg%prefix)

   ! Create file
   ncid = create_file(mpl,filename,nam%time_comm,0)

   do iv=1,nam%nv
      ! Get group name
      call nam%alias(nam%variables(iv),grpname)

      ! Define group
      grpid = define_grp(mpl,ncid,grpname)

      ! Write
      call avg%var(iv)%glb%write_hist(mpl,nam,geom,grpid)
   end do

   ! Close file
end if

end subroutine avg_write_hist

!----------------------------------------------------------------------
! Subroutine: avg_compute
!> Compute averaged statistics
!----------------------------------------------------------------------
subroutine avg_compute(avg,mpl,nam,geom,samp,mom,ne,prefix)

implicit none

! Passed variables
class(avg_type),intent(inout) :: avg  !< Averaged statistics
type(mpl_type),intent(inout) :: mpl   !< MPI data
type(nam_type),intent(in) :: nam      !< Namelist
type(geom_type),intent(in) :: geom    !< Geometry
type(samp_type),intent(in) :: samp    !< Sampling
type(mom_type),intent(in) :: mom      !< Moments
integer,intent(in) :: ne              !< Ensemble size
character(len=*),intent(in) :: prefix !< Prefix

! Local variables
integer :: iv,ig,ic2a
type(mom_blk_type) :: mom_blk

! Set name
@:set_name(avg_compute)

! Allocation
call avg%alloc(mpl,nam,geom,samp,mom%ne,mom%nsub,prefix)

! Compute averaged statistics
write(mpl%info,'(a10,a)') '','Compute averaged statistics'
call mpl%flush
do iv=1,nam%nv
   write(mpl%info,'(a13,a,a,a)') '','Block ',trim(nam%variables(iv)),':'
   call mpl%flush(newl=.false.)

   ! Global average
   call avg%var(iv)%glb%compute_global(mpl,nam,geom,samp,mom%blk(iv))

   if (nam%local_diag) then
      ! Moments block extension
      call mom_blk%ext(mpl,nam,geom,samp,mom%blk(iv))

      ! Local average
      call mpl%prog_init(samp%nc2a)
      do ic2a=1,samp%nc2a
         call avg%var(iv)%loc(ic2a)%compute_local(mpl,nam,geom,samp,mom_blk)
         call mpl%prog_print(ic2a)
      end do

      ! Final print
      call mpl%prog_final

      ! Release memory
      call mom_blk%dealloc
   else
      write(mpl%info,'(a)') ' done'
      call mpl%flush
   end if
end do

if (nam%avg_nbins>0) then
   ! Write histograms
   write(mpl%info,'(a10,a)') '','Write histograms'
   call mpl%flush
   call avg%write_hist(mpl,nam,geom)
end if

! Compute asymptotic statistics
write(mpl%info,'(a10,a)') '','Compute asymptotic statistics:'
call mpl%flush
do iv=1,nam%nv
   ! Initialization
   write(mpl%info,'(a13,a,a,a)') '','Block ',trim(nam%variables(iv)),':'
   call mpl%flush(newl=.false.)
   call mpl%prog_init(samp%nc2a+1)

   ! Global
   call avg%var(iv)%glb%compute_asy(mpl,nam,geom,ne)
   call mpl%prog_print(1)

   ! Local
   do ic2a=1,samp%nc2a
      call avg%var(iv)%loc(ic2a)%compute_asy(mpl,nam,geom,ne)
      call mpl%prog_print(ic2a+1)
   end do

   ! Final print
   call mpl%prog_final
end do

! Compute group statistics
write(mpl%info,'(a10,a)') '','Compute group statistics:'
call mpl%flush
do ig=1,nam%ng
   ! Initialization
   write(mpl%info,'(a13,a,a,a)') '','Block ',trim(nam%group_names(ig)),':'
   call mpl%flush(newl=.false.)
   call mpl%prog_init(samp%nc2a+1)

   ! Global
   call avg%grp(ig)%glb%init_group(mpl,nam,geom)

   ! Local
   do ic2a=1,samp%nc2a
      call avg%grp(ig)%loc(ic2a)%init_group(mpl,nam,geom)
   end do

   ! Accumulation over variables
   do iv=1,nam%nv
      if (nam%group_index(iv)==ig) then
         ! Global
         call avg%grp(ig)%glb%accumul_group(mpl,nam,geom,avg%var(iv)%glb)

         ! Local
         do ic2a=1,samp%nc2a
            call avg%grp(ig)%loc(ic2a)%accumul_group(mpl,nam,geom,avg%var(iv)%loc(ic2a))
         end do
      end if
   end do

   ! Normalization

   ! Global
   call avg%grp(ig)%glb%norm_group(mpl,nam,geom)

   ! Local
   do ic2a=1,samp%nc2a
      call avg%grp(ig)%loc(ic2a)%norm_group(mpl,nam,geom)
   end do

   ! Final print
   call mpl%prog_final
end do

end subroutine avg_compute

end module type_avg
