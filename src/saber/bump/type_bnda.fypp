module type_bnda

use fckit_mpi_module, only: fckit_mpi_sum
!$ use omp_lib
use tools_const, only: zero,half,one,pi
use tools_func, only: lonlat2xyz,vector_product,det
use tools_kinds, only: kind_real
use tools_repro, only: repro_th
use type_mesh, only: mesh_type
use type_mpl, only: mpl_type

implicit none

! Horizontal boundaries derived type
type bnda_lev_type
   ! Class
   integer :: id                           !< Boundary class of each level

   ! Boundaries structure
   integer :: n                            !< Number of boundary points
   real(kind_real),allocatable :: v1(:,:)  !< Mask boundary arcs, first vector
   real(kind_real),allocatable :: v2(:,:)  !< Mask boundary arcs, second vector
   real(kind_real),allocatable :: va(:,:)  !< Mask boundary arcs, orthogonal vector

   ! Bounding cap of each arc, used to reject arcs without testing them
   real(kind_real),allocatable :: vc(:,:)  !< Mask boundary arcs, cap centre
   real(kind_real),allocatable :: r(:)     !< Mask boundary arcs, cap angular radius
   real(kind_real),allocatable :: cosr(:)  !< Cosine of the cap angular radius
   real(kind_real),allocatable :: sinr(:)  !< Sine of the cap angular radius  
contains
   procedure :: init => bnda_lev_init
   procedure :: select => bnda_lev_select
   procedure :: check_arc => bnda_lev_check_arc
end type bnda_lev_type

! Boundaries derived type
type bnda_type
   ! Set of horizontal boundaries
   type(bnda_lev_type) :: hor                !< Horizontal boundaries for the union of levels
   type(bnda_lev_type),allocatable :: lev(:) !< Horizontal boundaries for each level

   ! Characteristics
   integer :: nclass                         !< Number of classes
   integer :: nmax                           !< Max number of arcs
contains
   procedure :: init => bnda_init
   procedure :: empty => bnda_empty
   procedure :: dealloc => bnda_dealloc
end type bnda_type

real(kind_real),parameter :: sel_margin = 1.0e-12_kind_real !< Rounding margin on the cap rejection test

private
public :: bnda_lev_type,bnda_type

contains

!----------------------------------------------------------------------
! Subroutine: bnda_lev_init
!> Initialization
!----------------------------------------------------------------------
subroutine bnda_lev_init(bnda_lev,mpl,mesh,gmask)

implicit none

! Passed variables
class(bnda_lev_type),intent(inout) :: bnda_lev !< Horizontal boundaries for one level
type(mpl_type),intent(inout) :: mpl            !< MPI data
type(mesh_type),intent(in) :: mesh             !< Mesh
logical,intent(in) :: gmask(mesh%n)            !< Mask

! Local variables
integer :: i,ii,j,k,kk,knext,kknext,ibnda
integer,allocatable :: bnda_to_grid(:,:)
real(kind_real) :: lon_arc(2),lat_arc(2),xbnda(2),ybnda(2),zbnda(2),vc(3),norm

! Set name
@:set_name(bnda_lev_init)

! Count boundary nodes
bnda_lev%n = 0
do i=1,mesh%n
   ii = mesh%order(i)
   if (.not.gmask(ii)) then
      ! Loop over neigbors
      do j=1,mesh%rows(i)%cols
         k = mesh%rows(i)%nodes(j)
         kk = mesh%order(k)
         if (j<mesh%rows(i)%cols) then
            knext = mesh%rows(i)%nodes(j+1)
         else
            knext = mesh%rows(i)%nodes(1)
         end if
         kknext = mesh%order(knext)
         if (.not.gmask(kk).and.gmask(kknext)) bnda_lev%n = bnda_lev%n+1
      end do
   end if
end do

! Allocation
allocate(bnda_to_grid(2,bnda_lev%n))
allocate(bnda_lev%v1(3,bnda_lev%n))
allocate(bnda_lev%v2(3,bnda_lev%n))
allocate(bnda_lev%va(3,bnda_lev%n))
allocate(bnda_lev%vc(3,bnda_lev%n))
allocate(bnda_lev%r(bnda_lev%n))
allocate(bnda_lev%cosr(bnda_lev%n))
allocate(bnda_lev%sinr(bnda_lev%n))

! Get boundary arcs
ibnda = 0
do i=1,mesh%n
   ii = mesh%order(i)
   if (.not.gmask(ii)) then
      ! Loop over neigbors
      do j=1,mesh%rows(i)%cols
         k = mesh%rows(i)%nodes(j)
         kk = mesh%order(k)
         if (j<mesh%rows(i)%cols) then
            knext = mesh%rows(i)%nodes(j+1)
         else
            knext = mesh%rows(i)%nodes(1)
         end if
         kknext = mesh%order(knext)
         if (.not.gmask(kk).and.gmask(kknext)) then
            ibnda = ibnda+1
            bnda_to_grid(1,ibnda) = i
            bnda_to_grid(2,ibnda) = k
         end if
      end do
   end if
end do

! Compute boundary arcs coordinates
do ibnda=1,bnda_lev%n
   lon_arc = mesh%lon(bnda_to_grid(:,ibnda))
   lat_arc = mesh%lat(bnda_to_grid(:,ibnda))
   call lonlat2xyz(mpl,lon_arc(1),lat_arc(1),xbnda(1),ybnda(1),zbnda(1))
   call lonlat2xyz(mpl,lon_arc(2),lat_arc(2),xbnda(2),ybnda(2),zbnda(2))
   bnda_lev%v1(:,ibnda) = (/xbnda(1),ybnda(1),zbnda(1)/)
   bnda_lev%v2(:,ibnda) = (/xbnda(2),ybnda(2),zbnda(2)/)
   call vector_product(bnda_lev%v1(:,ibnda),bnda_lev%v2(:,ibnda),bnda_lev%va(:,ibnda))

   ! Bounding cap: centred on the arc midpoint, with an angular radius of half the
   ! arc length. Two arcs whose caps do not overlap cannot cross, which lets
   ! bnda_select discard most of the coastline without any crossing test.
   vc = half*(bnda_lev%v1(:,ibnda)+bnda_lev%v2(:,ibnda))
   norm = sqrt(sum(vc**2))
   if (norm>zero) then
      bnda_lev%vc(:,ibnda) = vc/norm
   else
      ! Antipodal end points: the cap degenerates to the whole sphere
      bnda_lev%vc(:,ibnda) = bnda_lev%v1(:,ibnda)
   end if
   bnda_lev%cosr(ibnda) = sum(bnda_lev%vc(:,ibnda)*bnda_lev%v1(:,ibnda))
   bnda_lev%cosr(ibnda) = max(-one,min(one,bnda_lev%cosr(ibnda)))
   bnda_lev%r(ibnda) = acos(bnda_lev%cosr(ibnda))
   bnda_lev%sinr(ibnda) = sin(bnda_lev%r(ibnda))
end do

end subroutine bnda_lev_init

!----------------------------------------------------------------------
! Subroutine: bnda_lev_select
!> Select the boundary arcs that any arc inside a cap could possibly cross
!----------------------------------------------------------------------
subroutine bnda_lev_select(bnda_lev,mpl,lon,lat,radius,nsel,sel)

implicit none

! Passed variables
class(bnda_lev_type),intent(in) :: bnda_lev  !< Boundaries
type(mpl_type),intent(inout) :: mpl          !< MPI data
real(kind_real),intent(in) :: lon            !< Cap centre longitude
real(kind_real),intent(in) :: lat            !< Cap centre latitude
real(kind_real),intent(in) :: radius         !< Cap angular radius
integer,intent(out) :: nsel                  !< Number of selected arcs
integer,intent(inout) :: sel(:)              !< Selected arcs

! Local variables
integer :: ibnda
real(kind_real) :: v(3),cosrad,sinrad,cosmax

! Set name
@:set_name(bnda_lev_select)

! Every arc tested by the caller has both end points inside the cap, so an arc
! whose own bounding cap is further than radius+r from the centre cannot be
! crossed by any of them.
nsel = 0

if (bnda_lev%n>0) then
   call lonlat2xyz(mpl,lon,lat,v(1),v(2),v(3))
   cosrad = cos(radius)
   sinrad = sin(radius)

   if (bnda_lev%n>size(sel)) call mpl%abort('${subr}$','sel buffer too small for the boundary arcs')

   do ibnda=1,bnda_lev%n
      if (radius+bnda_lev%r(ibnda)>=pi) then
         ! The caps cover the sphere, no rejection possible
         nsel = nsel+1
         sel(nsel) = ibnda
      else
         ! cos(radius+r), expanded to keep this free of inverse trigonometry
         cosmax = cosrad*bnda_lev%cosr(ibnda)-sinrad*bnda_lev%sinr(ibnda)

         ! Margin of a few ulps, so that an arc grazing the cap edge is kept
         ! rather than rejected on rounding
         if (sum(v*bnda_lev%vc(:,ibnda))>=cosmax-sel_margin) then
            nsel = nsel+1
            sel(nsel) = ibnda
         end if
      end if
   end do
end if

end subroutine bnda_lev_select

!----------------------------------------------------------------------
! Subroutine: bnda_lev_check_arc
!> Check if an arc is crossing mask boundaries
!----------------------------------------------------------------------
subroutine bnda_lev_check_arc(bnda_lev,mpl,lon_s,lat_s,lon_e,lat_e,nsel,sel,valid,prt)

implicit none

! Passed variables
class(bnda_lev_type),intent(in) :: bnda_lev !< Boundaries
type(mpl_type),intent(inout) :: mpl         !< MPI data
real(kind_real),intent(in) :: lon_s         !< First point longitude
real(kind_real),intent(in) :: lat_s         !< First point latitude
real(kind_real),intent(in) :: lon_e         !< Second point longitude
real(kind_real),intent(in) :: lat_e         !< Second point latitude
integer,intent(in) :: nsel                  !< Number of pre-selected arcs (from bnda_lev_select)
integer,intent(in) :: sel(:)                !< Pre-selected arcs (from bnda_lev_select)
logical,intent(inout) :: valid              !< True for valid arcs
logical,intent(in),optional :: prt          !< Print values (very useful for debugging)

! Local variables
integer :: i,ibnda
real(kind_real) :: v1(3),v2(3),va(3),vp(3),t(4),tmin,tmax
logical :: lprt

! Set name
@:set_name(bnda_lev_check_arc)

! Local flag
lprt = .false.
if (present(prt)) lprt = prt

if (valid) then
   ! Transform to cartesian coordinates
   call lonlat2xyz(mpl,lon_s,lat_s,v1(1),v1(2),v1(3))
   call lonlat2xyz(mpl,lon_e,lat_e,v2(1),v2(2),v2(3))

   ! Compute arc orthogonal vector
   call vector_product(v1,v2,va)

   ! Check if arc is crossing boundary arcs
   do i=1,nsel
      ! Boundary arc index
      ibnda = sel(i)

      if (valid) then
         ! Compute factors
         call vector_product(va,bnda_lev%va(:,ibnda),vp)
         call det(v1,va,vp,t(1))
         call det(v2,va,vp,t(2))
         call det(bnda_lev%v1(:,ibnda),bnda_lev%va(:,ibnda),vp,t(3))
         call det(bnda_lev%v2(:,ibnda),bnda_lev%va(:,ibnda),vp,t(4))
         t(1) = -t(1)
         t(3) = -t(3)

         ! Get min/max
         tmin = minval(t)
         tmax = maxval(t)

         if ((abs(tmin)>repro_th).and.(abs(tmax)>repro_th)) then
            valid = (tmin*tmax<zero)
         else
            valid = .true.
         end if

         ! Print results
         if (lprt) then
            write(mpl%info,'(a,i5,f12.8,f12.8,l2)') 'in bnda_check_arc: ',ibnda,tmin,tmax,valid
            call mpl%flush
         end if
      end if

      ! Stop early
      if (.not.valid) exit
   end do
end if

end subroutine bnda_lev_check_arc

!----------------------------------------------------------------------
! Subroutine: bnda_init
!> Initialization
!----------------------------------------------------------------------
subroutine bnda_init(bnda,mpl,n,nl0,gmask_hor,gmask,mesh)

implicit none

! Passed variables
class(bnda_type),intent(inout) :: bnda !< Boundaries
type(mpl_type),intent(inout) :: mpl    !< MPI data
integer,intent(in) :: n                !< Grid size
integer,intent(in) :: nl0              !< Number of levels
logical,intent(in) :: gmask_hor(n)     !< Horizontal mask
logical,intent(in) :: gmask(n,nl0)     !< 3D mask
type(mesh_type),intent(in) :: mesh     !< Mesh

! Local variables
integer :: il0,jl0,i
integer :: ndiff(nl0)

! Set name
@:set_name(bnda_init)

! Union of masks
call bnda%hor%init(mpl,mesh,gmask_hor)
bnda%hor%id = 0

! Allocation
allocate(bnda%lev(nl0))

! Loop over levels
do il0=1,nl0
   call bnda%lev(il0)%init(mpl,mesh,gmask(:,il0))
end do

! Group levels by mask
do il0=1,nl0
   ndiff = 1
   do jl0=1,il0-1
      if (bnda%lev(jl0)%id==jl0) then
         ! Compare against a class representative only, and stop at the first difference
         ndiff(jl0) = 0
         do i=1,n
            if (gmask(i,il0).neqv.gmask(i,jl0)) then
               ndiff(jl0) = 1
               exit
            end if
         end do
      end if
   end do
   call mpl%f_comm%allreduce(ndiff,fckit_mpi_sum())

   bnda%lev(il0)%id = il0
   do jl0=1,il0-1
      if (ndiff(jl0)==0) then
         bnda%lev(il0)%id = jl0
         exit
      end if
   end do
end do

! Compute max number of arcs
bnda%nmax = 0
do il0=1,nl0
   bnda%nmax = max(bnda%nmax,bnda%lev(il0)%n)
end do

! Number of classes
bnda%nclass = 0
do il0=1,nl0
   if (bnda%lev(il0)%id==il0) bnda%nclass = bnda%nclass+1
end do

end subroutine bnda_init

!----------------------------------------------------------------------
! Subroutine: bnda_empty
!> Empty initialization
!----------------------------------------------------------------------
subroutine bnda_empty(bnda,nl0)

implicit none

! Passed variables
class(bnda_type),intent(inout) :: bnda !< Boundaries
integer,intent(in) :: nl0              !< Number of levels

! Local variables
integer :: il0,jl0,i
integer :: ndiff(nl0)

! Set name
@:set_name(bnda_init)

! Union of masks
bnda%hor%n = 0
print*, "ok",nl0
! Allocation
allocate(bnda%lev(nl0))

! Loop over levels
do il0=1,nl0
   bnda%lev(il0)%n = 0
end do

! Max number of arcs
bnda%nmax = 0

end subroutine bnda_empty

!----------------------------------------------------------------------
! Subroutine: bnda_dealloc
!> Release memory
!----------------------------------------------------------------------
subroutine bnda_dealloc(bnda)

implicit none

! Passed variables
class(bnda_type),intent(inout) :: bnda !< Boundaries

! Local variables
integer :: il0

! Set name
@:set_name(bnda_dealloc)

! Release memory
if (allocated(bnda%hor%v1)) deallocate(bnda%hor%v1)
if (allocated(bnda%hor%v2)) deallocate(bnda%hor%v2)
if (allocated(bnda%hor%va)) deallocate(bnda%hor%va)
if (allocated(bnda%hor%vc)) deallocate(bnda%hor%vc)
if (allocated(bnda%hor%r)) deallocate(bnda%hor%r)
if (allocated(bnda%hor%cosr)) deallocate(bnda%hor%cosr)
if (allocated(bnda%hor%sinr)) deallocate(bnda%hor%sinr)
if (allocated(bnda%lev)) then
   do il0=1,size(bnda%lev)
      if (allocated(bnda%lev(il0)%v1)) deallocate(bnda%lev(il0)%v1)
      if (allocated(bnda%lev(il0)%v2)) deallocate(bnda%lev(il0)%v2)
      if (allocated(bnda%lev(il0)%va)) deallocate(bnda%lev(il0)%va)
      if (allocated(bnda%lev(il0)%vc)) deallocate(bnda%lev(il0)%vc)
      if (allocated(bnda%lev(il0)%r)) deallocate(bnda%lev(il0)%r)
      if (allocated(bnda%lev(il0)%cosr)) deallocate(bnda%lev(il0)%cosr)
      if (allocated(bnda%lev(il0)%sinr)) deallocate(bnda%lev(il0)%sinr)
   end do
   deallocate(bnda%lev)
end if

end subroutine bnda_dealloc

end module type_bnda
